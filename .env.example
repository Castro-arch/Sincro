# ---------- Aplicacao ----------
NODE_ENV=development
PORT=3000

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=sincro
DB_PASSWORD=sincro
DB_NAME=sincro

# ---------- Redis (BullMQ) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------- Mercado Livre ----------
# Criados em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser exatamente igual a "URI de redirect" cadastrada no DevCenter.
ML_REDIRECT_URI=http://localhost:3000/ml/auth/callback
# Site do vendedor: MLB (Brasil), MLA (Argentina), MLM (Mexico)...
ML_SITE_ID=MLB
# Dominio de autorizacao correspondente ao site
ML_AUTH_DOMAIN=https://auth.mercadolivre.com.br
ML_API_URL=https://api.mercadolibre.com

# ---------- Jobs ----------
# Renovacao do token: token dura ~6h, checamos com folga
TOKEN_REFRESH_CRON=*/15 * * * *
# Margem (segundos) antes do vencimento para ja renovar o token
TOKEN_REFRESH_SKEW_SECONDS=1800
# Polling de pedidos (5-10 min)
ORDER_POLLING_CRON=*/5 * * * *

# ---------- Dashboard ----------
# Estoque igual ou abaixo disso dispara alerta de estoque baixo
LOW_STOCK_THRESHOLD=3
